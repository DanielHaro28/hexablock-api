{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run lint *)",
      "Bash(npm run build)",
      "Bash(npm ci)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma format)",
      "Bash(python3 -I docs/contracts/check_contracts.py)",
      "Bash(python -I docs/contracts/check_contracts.py)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)",
      "PowerShell(git branch *)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run test *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run build)",
      "PowerShell(npm ci)",
      "PowerShell(npx prisma generate)",
      "PowerShell(npx prisma validate)",
      "PowerShell(npx prisma format)",
      "PowerShell(python3 -I docs/contracts/check_contracts.py)",
      "PowerShell(python -I docs/contracts/check_contracts.py)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Edit(/.github/workflows/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.mcp.json)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npx prisma migrate *)",
      "Bash(npx prisma db *)",
      "Bash(docker compose *)",
      "PowerShell(git push *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npm update *)",
      "PowerShell(npx prisma migrate *)",
      "PowerShell(npx prisma db *)",
      "PowerShell(docker compose *)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/key.properties)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(aws *)",
      "Bash(docker system prune *)",
      "Bash(npx prisma migrate reset *)",
      "Bash(prisma migrate reset *)",
      "Bash(npm publish *)",
      "PowerShell(rm -rf *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -f*)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "PowerShell(aws *)",
      "PowerShell(docker system prune *)",
      "PowerShell(npx prisma migrate reset *)",
      "PowerShell(prisma migrate reset *)",
      "PowerShell(npm publish *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\""
          }
        ]
      }
    ]
  }
}