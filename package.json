{
  "name": "hexablock-api",
  "version": "0.1.0",
  "description": "HexaBlock Suite – NestJS REST API: auth, progress sync, leaderboards and levels",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "format": "prettier --write \"{src,test,prisma}/**/*.ts\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"{src,test,prisma}/**/*.ts\" \"*.{js,ts,json}\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects e2e --runInBand --passWithNoTests",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "16.0.8",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "6.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.5.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
