@startuml clases
' Diagrama de clases GENERAL de hexablock-api (enunciado §4.1, D-43, D-76).
' Muestra las 4 capas y cómo se comunican: los controladores (capa 3) usan casos de
' uso (capa 2), que dependen de puertos; los adaptadores de Prisma, argon2 y JWT
' implementan esos puertos. Las flechas apuntan siempre hacia el dominio.
' El detalle del dominio y de los casos de uso está en clases-dominio.puml.
' Imagen: abrir este archivo → Ctrl+Shift+P → "PlantUML: Export Current Diagram" → png.
' Los nombres son los previstos en ARQ-03-API; se revisan contra el código real.

set namespaceSeparator none
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ClassBorderColor #333333
skinparam ClassBackgroundColor #FFFFFF
skinparam PackageBorderColor #999999
skinparam nodesep 30
skinparam ranksep 45

package "Capa 4 · Frameworks (NestJS, Prisma)" {
  class PrismaService <<Singleton via DI>> {
    + client: PrismaClient
  }
  class JwtAuthGuard <<Chain of Responsibility>> {
    + canActivate(ctx: ExecutionContext): boolean
  }
  class RolesGuard <<Chain of Responsibility>> {
    + canActivate(ctx: ExecutionContext): boolean
  }
  class GlobalExceptionFilter {
    + catch(e: unknown, host: ArgumentsHost): void
  }
  class LeaderboardModule {
    + useFactory(): UseCase
  }
}

package "Capa 3 · Adaptadores (presentation/ e infrastructure/)" {
  class AuthController {
    + register(dto: RegisterDto): AuthResult
    + login(dto: LoginDto): AuthResult
  }
  class ProgressController {
    + get(user: User): ProgressDto[]
    + sync(user: User, gameId: string, dto: SyncDto): ProgressDto
  }
  class LeaderboardController {
    + get(gameId: string, q: LeaderboardQueryDto): LeaderboardPage
  }
  class LevelsController {
    + list(q: LevelsQueryDto): LevelsPage
    + upsert(dto: LevelDto): LevelDefinition
  }
  class PrismaUserRepository <<Adapter>> {
    - prisma: PrismaService
  }
  class PrismaProgressRepository <<Adapter>> {
    - prisma: PrismaService
  }
  class PrismaBestAttemptRepository <<Adapter>> {
    - prisma: PrismaService
  }
  class PrismaLevelRepository <<Adapter>> {
    - prisma: PrismaService
  }
  class PrismaTransactionRunner <<Adapter>> {
    - prisma: PrismaService
  }
  class Argon2PasswordHasher <<Adapter>>
  class JwtTokenIssuer <<Adapter>>
}

package "Capa 2 · Casos de uso (application/)" {
  interface UseCase<I, O> <<interface>> {
    + execute(input: I): Promise<O>
  }
  class CacheAspect<I, O> <<Proxy>> <<AOP>> {
    - inner: UseCase<I, O>
    - clock: IClock
  }
  class LoginUseCase {
    + execute(c: Credentials): Promise<AuthResult>
  }
  class SyncProgressUseCase {
    + execute(i: SyncInput): Promise<VariantProgress>
  }
  class GetLeaderboardUseCase {
    + execute(q: LeaderboardQuery): Promise<LeaderboardPage>
  }
  interface IUserRepository <<interface>> {
    + findByEmail(email: string): Promise<User?>
  }
  interface IProgressRepository <<interface>> {
    + lockForUpdate(userId: string, gameId: string): Promise<VariantProgress?>
    + save(p: VariantProgress): Promise<void>
  }
  interface IBestAttemptReader <<interface>> {
    + page(q: LeaderboardQuery): Promise<BestAttempt[]>
  }
  interface IBestAttemptRepository <<interface>> {
    + upsert(a: BestAttempt): Promise<void>
  }
  interface ILevelRepository <<interface>> {
    + changedSince(cursor: bigint, limit: number): Promise<LevelDefinition[]>
  }
  interface ITransactionRunner <<interface>> {
    + run<T>(fn: () => Promise<T>): Promise<T>
  }
  interface IPasswordHasher <<interface>> {
    + verify(hash: string, password: string): Promise<boolean>
  }
  interface ITokenIssuer <<interface>> {
    + issue(u: User): Promise<string>
    + verify(token: string): Promise<TokenClaims>
  }
}

package "Capa 1 · Entidades (domain/)" {
  class ProgressConsolidator {
    + consolidate(saved: VariantProgress, incoming: VariantProgress): VariantProgress
  }
  interface IRankingPolicy <<interface>> <<Strategy>> {
    + compare(a: BestAttempt, b: BestAttempt): number
  }
  abstract class DomainError {
    + code: string
  }
}

' ===== Capa 4 =====
LeaderboardModule ..> CacheAspect : arma
LeaderboardModule ..> GetLeaderboardUseCase : arma
JwtAuthGuard ..> ITokenIssuer : verifica el JWT
GlobalExceptionFilter ..> DomainError : traduce a Problem Details
PrismaUserRepository --> PrismaService
PrismaProgressRepository --> PrismaService
PrismaBestAttemptRepository --> PrismaService
PrismaLevelRepository --> PrismaService
PrismaTransactionRunner --> PrismaService

' ===== Capa 3 → capa 2 =====
AuthController --> UseCase : Register, Login
ProgressController --> UseCase : GetProgress, SyncProgress
LeaderboardController --> UseCase : GetLeaderboard (con caché)
LevelsController --> UseCase : ListLevels, UpsertLevel
PrismaUserRepository ..|> IUserRepository
PrismaProgressRepository ..|> IProgressRepository
PrismaBestAttemptRepository ..|> IBestAttemptRepository
PrismaLevelRepository ..|> ILevelRepository
PrismaTransactionRunner ..|> ITransactionRunner
Argon2PasswordHasher ..|> IPasswordHasher
JwtTokenIssuer ..|> ITokenIssuer

' ===== Capa 2 =====
CacheAspect ..|> UseCase
CacheAspect o-- UseCase : cachea
LoginUseCase ..|> UseCase
SyncProgressUseCase ..|> UseCase
GetLeaderboardUseCase ..|> UseCase
IBestAttemptRepository --|> IBestAttemptReader
LoginUseCase --> IUserRepository
LoginUseCase --> IPasswordHasher
LoginUseCase --> ITokenIssuer
SyncProgressUseCase --> IProgressRepository
SyncProgressUseCase --> IBestAttemptRepository
SyncProgressUseCase --> ITransactionRunner
GetLeaderboardUseCase --> IBestAttemptReader

' ===== Capa 2 → capa 1 =====
SyncProgressUseCase --> ProgressConsolidator : usa
GetLeaderboardUseCase --> IRankingPolicy : usa

legend right
  **Cómo leerlo**
  ..|> implementa una interfaz · --|> hereda
  --> usa (dependencia que se guarda) · ..> crea o usa de paso
  o-- agregación (el aspecto envuelve otro caso de uso)
  «...» en una clase = patrón de diseño (ARQ-03-API §5) · T? = T o null
  Todas las flechas entre capas apuntan hacia la capa 1
  Los demás casos de uso, el dominio completo y los aspectos de
  registro y métricas están en clases-dominio.puml
  HealthController, PrismaHealthProbe y AccessLogInterceptor siguen el mismo patrón
endlegend

@enduml
