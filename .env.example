# Copy this file to `.env` and fill in the values. `.env` is ignored by git and must never be committed
# (SEC-WEB-04). These are placeholders, not real secrets.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database --------------------------------------------------------------
# docker-compose.dev.yml publishes PostgreSQL on host port 5433 (5432 is often taken by a local install).
POSTGRES_USER=hexablock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hexablock
DATABASE_URL=postgresql://hexablock:change-me@localhost:5433/hexablock

# --- Authentication (SEC-API-02, D-44) --------------------------------------
# HS256 secret: at least 32 random bytes. It is left empty on purpose: the API refuses to start without it.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Lifetime of the access token in seconds (24 h, D-44).
JWT_EXPIRES_IN_SECONDS=86400

# --- Errors (D-51) -----------------------------------------------------------
# Public base URI of the API's problem types; `type` = PROBLEM_BASE_URI + code. Never a private host.
PROBLEM_BASE_URI=https://hexablock-api.example/problems/
